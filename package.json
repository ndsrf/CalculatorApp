{
  "name": "calculator-app-ai-native",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "description": "Provider-agnostic reference repository for AI-native engineering practices, using a deliberately tiny Calculator App",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:docs": "tsx scripts/lint-docs.ts",
    "lint:prompts": "tsx scripts/check-prompts.ts",
    "lint:skills": "tsx scripts/check-skills.ts",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs && eslint src",
    "lint:deadcode": "knip",
    "docs:state-chart": "tsx scripts/generate-state-chart.ts",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "harvest:trace": "tsx scripts/harvest-trace.ts",
    "trace:demo": "tsx scripts/run-traced-demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run src/core/parser.test.ts src/core/calculator.test.ts src/ai/expression-translator.test.ts src/observability/guardrails.test.ts tests/pre-tool-guard.test.ts tests/check-prompts.test.ts tests/check-skills.test.ts tests/dev-server.test.ts tests/gates.test.ts",
    "test:model": "vitest run src/core/calculator.model.test.ts",
    "test:cli": "vitest run tools/calc-verify/tests/",
    "test:ui": "vitest run tests/ui-contract.test.ts",
    "test:fuzz": "vitest run tests/ui-fuzz.test.ts",
    "test:gates": "tsx scripts/test-gates.ts",
    "verify:cli": "tsx tools/calc-verify/index.ts",
    "eval": "tsx scripts/run-eval.ts",
    "eval:deterministic": "tsx scripts/run-eval.ts --deterministic",
    "eval:simulate": "tsx scripts/simulate-eval.ts",
    "check": "npm run format:check && npm run lint:docs && npm run lint:prompts && npm run lint:skills && npm run lint:arch && npm run lint:deadcode && npm run docs:state-chart && git diff --exit-code docs/state-chart.md && npm run build && npm test && npm run eval:deterministic"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "fast-check": "^3.23.2",
    "js-yaml": "^5.5.0",
    "knip": "^6.48.0",
    "playwright": "^1.50.0",
    "prettier": "^3.10.1",
    "promptfoo": "^0.126.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
