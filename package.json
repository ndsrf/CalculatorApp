{
  "name": "calculator-app-ai-native",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal reference repository demonstrating an AI-native engineering workflow for a Calculator App",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint:docs": "tsx scripts/lint-docs.ts",
    "test": "vitest run",
    "test:unit": "vitest run src/core/parser.test.ts src/core/calculator.test.ts",
    "test:model": "vitest run src/core/calculator.model.test.ts",
    "test:cli": "vitest run tools/calc-verify/tests/",
    "verify:cli": "tsx tools/calc-verify/index.ts",
    "eval": "tsx scripts/run-eval.ts",
    "eval:deterministic": "tsx scripts/run-eval.ts --deterministic"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "fast-check": "^3.23.2",
    "js-yaml": "^5.5.0",
    "playwright": "^1.50.0",
    "promptfoo": "^0.109.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
