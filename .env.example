# Required only for the llm-rubric portion of `npm run eval`.
# Deterministic evals (`npm run eval:deterministic`), `npm run lint:docs`,
# `npm run test:unit`, `npm run test:model`, `npm run test:cli`, and
# `npm run verify:cli` all run completely offline without an API key.
OPENAI_API_KEY=sk-your-openai-api-key-here
